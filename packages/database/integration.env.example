# Public browser credential used by all role-scoped portal clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# Server-only credential used exclusively for isolated setup and cleanup.
# SUPABASE_SECRET_KEY is also accepted for newer Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Required only when deliberately auditing a disposable remote project.
SUPABASE_AUDIT_ALLOW_REMOTE=false
